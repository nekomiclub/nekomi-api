    "@types/imagemin-webp": "^7.0.3",
    "@types/jest": "^29.5.10",
    "@types/multer": "^1.4.11",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^5.54.1",
    "@typescript-eslint/parser": "^5.54.1",
    "eslint": "^8.36.0",
    "filehound": "^1.17.6",
    "jest": "^29.7.0",

{
  "name": "nekomi-api",
  "private": true,
  "version": "1.3.2",
  "main": "./src/index.js",
  "type": "module",
  "scripts": {
    "dev": "npx nodemon devMode",
    "dev-test": "npx nodemon devMode testMode",
    "start": "npx tsx ./src/index.ts prodMode",
    "test": "npx jest --silent",
    "test-standalone": "npx jest --silent standalone",
    "build": "npx eslint . --fix && git add . && npx tsc",
    "find_circular": "npx madge --circular --extensions ts ."
  },
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ip": "^1.1.3",
    "@types/jest": "^29.5.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.8",
    "@types/validator": "^13.12.2",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^5.54.1",
    "@typescript-eslint/parser": "^5.54.1",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-sort-imports-es6-autofix": "^0.6.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^29.7.0",
    "nodemon": "^2.0.20",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.3",
    "ts-node": "^10.9.1",
    "tsx": "^4.7.2",
    "typescript": "^4.9.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!variables/.*)"
    ],
    "testPathIgnorePatterns": [
      "dist/"
    ]
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "chalk": "^4.1.2",
    "cookie-parser": "^1.4.6",
    "cookies": "^0.8.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "fuse.js": "^7.0.0",
    "get-video-duration": "^4.1.0",
    "inquirer": "^11.0.2",
    "ip": "^1.1.8",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.1",
    "multer": "^1.4.5-lts.1",
    "node": "^21.6.0",
    "puppeteer": "^23.2.1",
    "url-slug": "^4.0.1",
    "uuid": "^9.0.1",
    "validator": "^13.12.0",
    "ws": "^8.16.0"
  }

{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES6",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "node",
    "types": [
      "node"
    ],
    "allowJs": true,
    "rootDir": "./",
    "outDir": "./build",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "skipLibCheck": true,
    "paths": {
      "~/intf/*": [
        "./src/interfaces/*",
      ],
      "~/service/*": [
        "./src/services/*",
      ],
      "~/repo/*": [
        "./src/repositories/*",
      ],
      "~/utils/*": [
        "./src/utils/*",
      ],
      "~/*": [
        "./src/*",
      ]
    }
  },
  "include": ["src/**/*.*"],
  "exclude": ["node_modules", "build", "dist", ".cache"],
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node",
    "transpileOnly": true,
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  }
}
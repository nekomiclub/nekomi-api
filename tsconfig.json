{
  "compilerOptions": {
    "target": "ES6",
    "lib": [
      "ES6",
      "ESNext"
    ],
    "module": "ESNext",
    "rootDir": "./",
    "moduleResolution": "node",
    "types": [
      "node",
      "jest"
    ],
    "allowJs": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "skipLibCheck": true,
    "paths": {
      "~/core/*": [
        "./src/_core/*",
      ],
      "~/services/*": [
        "./src/services/*",
      ],
      "~/utils/*": [
        "./src/utils/*",
      ],
      "~/*": [
        "./src/*",
      ]
    }
  },
  "include": [
    "**/*.*",
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".cache"
  ],
  "lib": [
    "esnext"
  ],
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node",
    "transpileOnly": true,
  },
}
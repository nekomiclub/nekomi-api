{
  "compilerOptions": {
    // Runtime
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    // Build
    "rootDir": "./src",
    "outDir": "./dist",
    "allowJs": false,
    "sourceMap": true,

    // Type checking
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,

    // Imports
    "paths": {
      "*": ["./*"],
      "~/intf/*": ["./src/interfaces/*"],
      "~/service/*": ["./src/services/*"],
      "~/repo/*": ["./src/repositories/*"],
      "~/utils/*": ["./src/utils/*"],
      "~/*": ["./src/*"]
    }
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["node_modules", "dist", ".cache"]
}
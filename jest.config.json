{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "transformIgnorePatterns": [
    "node_modules/(?!variables/.*)"
  ],
  "testPathIgnorePatterns": [
    "dist/"
  ],
  "moduleNameMapper": {
    "^~/core/(.*)$": "<rootDir>/src/_core/$1",
    "^~/interfaces/(.*)$": "<rootDir>/src/_core/interfaces/$1",
    "^~/(.*)$": "<rootDir>/src/$1"
  }
}